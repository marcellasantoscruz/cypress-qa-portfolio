{
  "$id": "serverest/login",
  "type": "object",
  "required": ["message", "authorization"],
  "properties": {
    "message": { "type": "string", "const": "Login realizado com sucesso" },
    "authorization": { "type": "string", "pattern": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
  },
  "additionalProperties": false
}
