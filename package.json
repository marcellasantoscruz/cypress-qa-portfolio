{
  "name": "cypress-qa-portfolio",
  "version": "1.0.0",
  "description": "Portfólio de automação de testes com Cypress: E2E web, API REST, contrato, acessibilidade e segurança, com CI no GitHub Actions.",
  "private": true,
  "author": "Marcella Santos Cruz",
  "license": "MIT",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:web": "cypress run --spec \"cypress/e2e/web/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:security": "cypress run --spec \"cypress/e2e/security/**/*.cy.js\"",
    "test:a11y": "cypress run --spec \"cypress/e2e/accessibility/**/*.cy.js\"",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:known-vulns": "cypress run --spec \"cypress/e2e/security/**/*.cy.js\" --expose grepTags=@known-vuln",
    "api:local": "npx -y serverest@3 --nodoc",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "cypress": "^16.1.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.12.0"
  }
}
